# Copy to .env for local development. Never commit .env (see .gitignore).
# No secrets are committed; values below are empty placeholders or safe defaults.

# Android / iOS Google Maps SDK keys (empty until provisioned).
GOOGLE_MAPS_KEY_ANDROID=
GOOGLE_MAPS_KEY_IOS=

# Firebase project id for emulators / real backend (empty = emulator default).
FIREBASE_PROJECT_ID=

# Mock-mode flags: default true so the app boots without a real backend.
MOCK_AUTH=true
MOCK_TRIPS=true
MOCK_LOCATION=true
