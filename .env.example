# Copy to .env for local development. Never commit .env (see .gitignore).
# No secrets are committed; values below are empty placeholders or safe defaults.

# Android / iOS Google Maps SDK keys (empty until provisioned).
GOOGLE_MAPS_KEY_ANDROID=
GOOGLE_MAPS_KEY_IOS=

# Firebase project id for emulators / real backend (empty = emulator default).
# Local emulators: `firebase emulators:start --project demo-tripmesh`
# (firebase.json sets emulators.singleProjectMode=true for this).
FIREBASE_PROJECT_ID=

# Mock-mode flags: default true so the app boots without a real backend.
# These mirror AppConfig.mockMode master switch (mockMode=true => all
# MOCK_* behave as true; unset/real backend wires up in P0-02+).
MOCK_AUTH=true
MOCK_TRIPS=true
MOCK_LOCATION=true
MOCK_DIRECTIONS=true
MOCK_FCM=true

# Feature flags (safe defaults for P0-01).
CAR_ENABLED=false
